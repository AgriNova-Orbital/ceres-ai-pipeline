# Portainer API deployment settings for scripts/deploy_portainer_stack.py.
# Copy to deploy/lab/portainer.env on the lab VM and fill values there.
# Do not commit real API tokens, stack IDs from private hosts, or secret values.

PORTAINER_URL=
PORTAINER_API_TOKEN=
PORTAINER_ENDPOINT_ID=

PORTAINER_STAGING_STACK_ID=
PORTAINER_STAGING_STACK_NAME=ceres-staging

PORTAINER_PILOT_STACK_ID=
PORTAINER_PILOT_STACK_NAME=ceres-pilot
