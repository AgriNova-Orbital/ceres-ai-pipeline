# Ceres lab stack runtime environment.
# Copy to a private env file on the lab VM and keep real values out of git.

APP_VERSION=0.2.0
CERES_API_IMAGE=ghcr.io/agrinova-orbital/ceres-api:sha-
CERES_FRONTEND_IMAGE=ghcr.io/agrinova-orbital/ceres-frontend:sha-
CERES_DATA_ROOT=/srv/ceres
CERES_API_HOST_BIND=127.0.0.1:5255
CERES_FRONTEND_HOST_BIND=127.0.0.1:3202

WEBUI_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
CLERK_JWT_AUDIENCE=
CLERK_JWKS_URL=
CLERK_JWKS_CACHE_TTL_SECONDS=300

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=0.2.0
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENABLE_LOGS=true
SENTRY_LOG_LEVEL=INFO
SENTRY_BREADCRUMB_LEVEL=INFO
SENTRY_EVENT_LEVEL=ERROR
APP_LOG_LEVEL=INFO
NEXT_PUBLIC_SENTRY_ENABLE_LOGS=true
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_RELEASE=0.2.0

NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=Ceres API Staging
NEW_RELIC_WORKER_APP_NAME=Ceres Worker Staging
NEW_RELIC_LOG=stdout
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
